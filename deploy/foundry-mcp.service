[Unit]
Description=Foundry MCP bridge
After=network.target foundry.service
Wants=foundry.service

[Service]
Type=simple
WorkingDirectory={{DEPLOY_APP_DIR}}
ExecStart={{DEPLOY_NODE_PATH}} {{DEPLOY_APP_DIR}}/dist/index.js
Restart=always
RestartSec=5
User={{DEPLOY_SERVICE_USER}}
Environment=NODE_ENV=production
EnvironmentFile=-/etc/foundry-mcp.env
Environment=HOST=127.0.0.1
Environment=PORT=8765
Environment=FOUNDRY_DATA_DIR={{DEPLOY_FOUNDRY_DATA_DIR}}

[Install]
WantedBy=multi-user.target
